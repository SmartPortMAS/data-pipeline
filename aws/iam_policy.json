{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StagingBucketReadWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME_HERE",
        "arn:aws:s3:::BUCKET_NAME_HERE/*"
      ]
    },
    {
      "Sid": "CollectorEnvRead",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter"],
      "Resource": "arn:aws:ssm:ap-northeast-2:*:parameter/smartport/collector-env"
    }
  ]
}
