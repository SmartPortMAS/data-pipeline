# ── 울산항만공사 Open API ───────────────────────────────────────────────────
UPA_SERVICE_KEY=여기에_발급키_입력

# ── 공공데이터포탈 API 키 (디코딩된 값) ────────────────────────────────────
KOSHA_MSDS_API_KEY=여기에_디코딩된_API_키_입력
KHOA_API_KEY=여기에_KHOA_API_키_입력

# ── 기상청 APIHUB ───────────────────────────────────────────────────────────
KMA_BUOY_AUTH_KEY=여기에_기상청_APIHUB_인증키_입력

# ── 공공데이터포털 기상청 단기예보(getVilageFcst) — 풍속/파고 예보 ──────────
KMA_API_KEY=여기에_공공데이터포털_기상청_단기예보_디코딩키_입력

# ── 해양수산부 항만기상정보시스템 ───────────────────────────────────────────
MMAF_API_KEY=여기에_항만기상_API_키_입력

# ── 해양수산부 PORT-MIS 선박운항정보 (backend/.env의 PORT_MIS_API_KEY와 동일 값) ──
PORT_MIS_API_KEY=여기에_PORT_MIS_API_키_입력

# ── aisstream.io 실시간 AIS ─────────────────────────────────────────────────
AISSTREAM_API_KEY=여기에_aisstream_API_키_입력

# ── PostgreSQL (마스터 스테이징 DB) ────────────────────────────────────────
# DATABASE_URL을 쓰거나, 아래 POSTGRES_* 5개를 개별로 설정 (기본값 없음, 둘 중 하나 필수)
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=여기에_DB이름_입력
POSTGRES_USER=여기에_DB유저_입력
POSTGRES_PASSWORD=여기에_PG_비밀번호_입력

# ── Neo4j (지식 그래프 마스터 DB) ──────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=여기에_NEO4J_비밀번호_입력
NEO4J_DATABASE=neo4j
